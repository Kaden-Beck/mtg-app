    # This test forces the design decision.
    ...

def test_foil_field_casing_variations():
    """Manabox: 'Foil'/empty. Moxfield: 'foil'/'etched'/empty. Archidekt: 'true'/'false'."""
    ...

def test_round_trip_manabox_to_moxfield_preserves_scryfall_id():
    cards_in = from_manabox(SAMPLE_MANABOX_CSV)
    moxfield_csv = to_moxfield(cards_in)
    cards_out = from_moxfield(moxfield_csv)
    assert {c.scryfall_id for c in cards_in} == {c.scryfall_id for c in cards_out}
```

