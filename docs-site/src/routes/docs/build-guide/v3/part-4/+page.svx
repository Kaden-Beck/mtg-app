## Step 2: Idempotency test

```python
# backend/tests/test_scryfall_sync_integration.py
from sqlalchemy import select, func
from app.models.models import Card
from app.services.scryfall_sync import sync_scryfall_bulk_from_iter
from tests.fixtures.scryfall_sample import SAMPLE_CARDS

async def test_sync_is_idempotent(db_session):
    # First run
    await sync_scryfall_bulk_from_iter(db_session, SAMPLE_CARDS)
    first_count = await db_session.scalar(select(func.count()).select_from(Card))

    # Capture timestamps
    rows = (await db_session.execute(select(Card.id, Card.updated_at))).all()
    first_timestamps = {r.id: r.updated_at for r in rows}

    # Second run with identical input
    await sync_scryfall_bulk_from_iter(db_session, SAMPLE_CARDS)
    second_count = await db_session.scalar(select(func.count()).select_from(Card))

    assert first_count == second_count
    # NOTE: This will fail until updated_at is in the upsert set_ dict.
    # Drives the fix in Step 4.
    rows = (await db_session.execute(select(Card.id, Card.updated_at))).all()
    second_timestamps = {r.id: r.updated_at for r in rows}
    for id_, ts in second_timestamps.items():
        assert ts > first_timestamps[id_], \
            f"updated_at not refreshed on re-sync for {id_}"
```

This test requires refactoring `sync_scryfall_bulk` so it accepts an iterable of card dicts (decoupling HTTP from DB). Do that refactor now:

```python
