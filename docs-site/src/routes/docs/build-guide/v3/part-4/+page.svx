    return await sync_scryfall_bulk_from_iter(db, cards)

async def sync_scryfall_bulk_from_iter(
    db: AsyncSession, cards: list[dict]
) -> int:
    """DB-only ingest. No HTTP. Test surface."""
    # ... existing upsert logic ...
```

